# Base image: Ubuntu 26.04 using amd64v3 architecture
FROM ubuntu:26.04

# Enable x86-64-v3 optimizations globally in environment for the container runtime
ENV CFLAGS="-march=x86-64-v3 -O3"
ENV CXXFLAGS="-march=x86-64-v3 -O3"
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies required for SteamCMD and Dune Networking
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y \
    curl \
    wget \
    lib32gcc-s1 \
    lib32stdc++6 \
    ca-certificates \
    tzdata \
    locales \
    && rm -rf /var/lib/apt/lists/*

# Setup locale
RUN sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    dpkg-reconfigure locales && \
    update-locale LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8 

# Create an unprivileged user for the game server
RUN useradd -m -s /bin/bash dune
USER dune
WORKDIR /home/dune

# Download and install SteamCMD
RUN mkdir -p /home/dune/steamcmd && \
    cd /home/dune/steamcmd && \
    curl -sqL "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz" | tar zxvf -

# Expose Game and Query ports
EXPOSE 7777/udp 27015/udp

# Add initialization script
COPY --chown=dune:dune start.sh /home/dune/start.sh
RUN chmod +x /home/dune/start.sh

CMD ["/home/dune/start.sh"]
